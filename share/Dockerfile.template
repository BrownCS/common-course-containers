# Define a base for the image
FROM {{BASE_IMAGE}}

# Avoid interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Set up environment
ENV TZ=America/New_York

RUN apt-get update && \
    apt-get install -y \
      locales \
      bsdmainutils \
      sudo \
      git \
      nano \
      vim \
      neovim \
      wget \
      curl \
      xxd \
      jq && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen && \
    rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Allow any user to sudo
RUN echo "ALL ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create courses directory for volume mounting
RUN mkdir -p /courses && chmod 755 /courses

# Create simple CCC container marker
RUN touch /etc/ccc-container

# Copy ccc, libraries, registry, and installer
COPY ccc /usr/local/bin/ccc
COPY . /usr/local/share/ccc/
RUN chmod 755 /usr/local/bin/ccc /usr/local/share/ccc/course_installer.sh || true && \
    chmod -R a+rX /usr/local/share/ccc || true
# this next line was required for csci 1515 SEAL usage on department machines, consider removing
RUN chmod o+w /usr/local /usr/local/lib /usr/local/include /usr/local/bin 2>/dev/null || true
# Set custom zsh-like prompt as environment variable (works for all bash sessions)
ENV PS1="\[\033[1;32m\][\u@\h]\[\033[0m\] \[\033[1;34m\]\w\[\033[0m\] "
ENV CCC_MANAGED_ENV=false

CMD [ "bash" ]
