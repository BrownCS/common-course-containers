#!/usr/bin/env bash
set -euo pipefail

# Entry point for the CCC CLI
# calls into library helpers (courses, runtime, container_helpers, etc.).
# removed host mode and container mode in favor of a more centralized system

# Script directory — prefer the repository `share/` sibling, otherwise fall back to installed share directory.
# This keeps dev checkouts and installed prefixes working uniformly.
# NOTE: might be able to be trimmed later depending on installation implementation
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

# Prefer a sibling `share/` directory in the repository (dev mode).
# Otherwise fall back to installed `share` locations (user or system).
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# Dev checkout: prefer `share/ccc` if present (handles some packaging layouts),
# otherwise fall back to plain `share/` for repo checkouts.
if [[ -d "$REPO_ROOT/share/ccc" ]]; then
  SCRIPT_DIR="$REPO_ROOT/share/ccc"
elif [[ -d "$REPO_ROOT/share" ]]; then
  SCRIPT_DIR="$REPO_ROOT/share"
# User install prefix
elif [[ -d "$HOME/.local/share/ccc" ]]; then
  SCRIPT_DIR="$HOME/.local/share/ccc"
# System install prefix
elif [[ -d "/usr/local/share/ccc" ]]; then
  SCRIPT_DIR="/usr/local/share/ccc"
fi

# Helper that loads files and gives more detailed errors
source_lib() {
  lib="$1"
  flat_file="$SCRIPT_DIR/$lib.sh"

  if [ -f "$flat_file" ]; then
    # shellcheck disable=SC1090
    . "$flat_file"
  else
    printf 'ERROR: Library file not found: %s\n' "$flat_file" >&2
    exit 1
  fi
}

# Load core utilities and common helpers
source_lib "utils"
source_lib "config"
source_lib "registry"
source_lib "courses"
source_lib "container_helpers"
source_lib "runtime"
# Make REGISTRY_FILE available to libraries that expect it
REGISTRY_FILE="${registry_file:-$SCRIPT_DIR/registry.csv}"

# load config (courses directory and auto update preferences)
load_config 2>/dev/null || true
export CCC_MANAGED_ENV=${CCC_MANAGED_ENV:-false}

# Default courses directory for both host and container environments.
# In containers, the mounted courses tree should be available at /courses.
if [ -z "${CCC_COURSES_DIR:-}" ]; then
  if is_container_environment; then
    export CCC_COURSES_DIR="/courses"
  else
    export CCC_COURSES_DIR="${HOME}/courses"
  fi
fi

## Resolve and normalize CCC_COURSES_DIR early so all libraries see absolute pth
if [ -n "${CCC_COURSES_DIR:-}" ]; then
  case "$CCC_COURSES_DIR" in
    "~"|~/*) CCC_COURSES_DIR="${HOME}${CCC_COURSES_DIR#~}" ;;
  esac
  if cd "$CCC_COURSES_DIR" >/dev/null 2>&1; then
    CCC_COURSES_DIR=$(pwd -P)
  fi
fi

# Single dispatch for ccc commands
case "${1:-}" in
  auto-update)
    case "${2:-}" in
    status)
      printf 'CCC_AUTO_UPDATE=%s\n' "${CCC_AUTO_UPDATE:-false}"
      exit 0 ;;
    enable)
      set_config CCC_AUTO_UPDATE true
      printf '%s\n' "Automatic updates enabled"
      exit 0 ;;
    disable)
      set_config CCC_AUTO_UPDATE false
      printf '%s\n' "Automatic updates disabled"
      exit 0 ;;
    *)
      printf '%s\n' "Usage: ccc auto-update status|enable|disable" >&2
      exit 2 ;;
    esac ;;
  init)
    # Run interactive init (prompt_init handles reads)
    prompt_init
    exit 0 ;;
  list)
    # list available courses from registry
    registry_list
    exit 0 ;;
  open)
    # ccc open <course> [--local] [--no-shell]
    course="${2:-}"
    if [ -z "$course" ]; then
      printf '%s\n' "Usage: ccc open <course> [--local] [--no-shell]" >&2
      exit 2
    fi
    # shift past 'open' and the course name
    shift 2 || true
    # load open helper (required)
    source_lib "open"
    ccc_open "$course" "$@"
    exit $? ;;
  config)
    # ccc config get KEY | ccc config set KEY VALUE
    case "${2:-}" in
      get)
        key="${3:-}"
        if [ -z "$key" ]; then
          printf '%s\n' "Usage: ccc config get <KEY>" >&2
          exit 2
        fi
        # this makes it easier to change courses dir
        if [ "$key" = "courses" ]; then
          key=CCC_COURSES_DIR
        fi
        load_config
        # shellcheck disable=SC2086
        eval "printf '%s\n' \"\${${key}:-}\""
        exit 0 ;;
      set)
        key="${3:-}"; value="${4:-}"
        if [ -z "$key" ] || [ -z "$value" ]; then
          printf '%s\n' "Usage: ccc config set <KEY> <VALUE>" >&2
          exit 2
        fi
        if [ "$key" = "courses" ]; then
          key=CCC_COURSES_DIR
        fi
        set_config "$key" "$value"
        printf 'Set %s\n' "$key"
        exit 0 ;;
      *)
        printf '%s\n' "Usage: ccc config get|set" >&2
        exit 2 ;;
    esac ;;
esac